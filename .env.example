# Target language: "it" (Italian, default) or "es" (Spanish); a folder under content/languages/.
# Restart the server and reload the page after changing it.
TARGET_LANGUAGE=it

# LLM Provider: "codex-cli", "claude-cli", "gemini", "openai", or "ollama"
LLM_PROVIDER=codex-cli

# CLI subscriptions (optional)
# Leave LLM_MODEL blank for the default: Sonnet with claude-cli (round 126), the CLI's own with codex-cli.
# With claude-cli, LLM_MODEL=default gives the account's own default model, and haiku is the fastest.
# LLM_MODEL=
# CODEX_CLI_PATH=/opt/homebrew/bin/codex
# CLAUDE_CLI_PATH=/opt/homebrew/bin/claude
# LLM_CLI_TIMEOUT_MS=120000

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (round 170): a key from https://aistudio.google.com/apikey. Blank GEMINI_MODEL = gemini-3.8-flash.
GEMINI_API_KEY=
# GEMINI_MODEL=

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Server
PORT=3001
# Optional; defaults to server/data/saves, independent of the launch directory.
PARALLANG_SAVE_DIR=
# Optional (round 145): also write every save as a JSON file to a branch of a GitHub repository, and read it back when
# the save directory has lost it. Both are needed. The token needs "Contents: Read and write" on the repository.
# PARALLANG_GITHUB_TOKEN=
# PARALLANG_GITHUB_REPO=owner/name
# PARALLANG_GITHUB_BRANCH=saves
# PARALLANG_GITHUB_DIR=saves
