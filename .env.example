# LLM Provider: "codex-cli", "claude-cli", "openai", or "ollama"
LLM_PROVIDER=codex-cli

# CLI subscriptions (optional)
# Leave LLM_MODEL blank to use the selected CLI's own default.
# LLM_MODEL=
# CODEX_CLI_PATH=/opt/homebrew/bin/codex
# CLAUDE_CLI_PATH=/opt/homebrew/bin/claude
# LLM_CLI_TIMEOUT_MS=120000

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Server
PORT=3001
# Optional; defaults to server/data/saves, independent of the launch directory.
PARALLANG_SAVE_DIR=
