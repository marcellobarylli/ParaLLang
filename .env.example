# LLM Provider: "openai" or "ollama"
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Optional shared override for the selected provider
# LLM_MODEL=

# Server
PORT=3001
# Optional; defaults to server/data/saves, independent of the launch directory.
PARALLANG_SAVE_DIR=
